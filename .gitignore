# =====================================================================
# crux — .gitignore
# =====================================================================
# What ships in the repo:  source, docs, scripts, dashboard/, tests/
# What DOES NOT ship:      build outputs, downloaded binaries, generated
#                          clips, IDE folders, logs, OS cruft, secrets.
# =====================================================================


# ---------------------------------------------------------------------
# Build outputs (CMake, MSBuild, Ninja, Make)
# ---------------------------------------------------------------------
build/
build-*/
cmake-build-*/
out/build/
out/install/
Debug/
Release/
x64/
x86/
Win32/

# ---------------------------------------------------------------------
# CMake internals — in case someone runs cmake at the repo root
# ---------------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
CMakeScripts/
cmake_install.cmake
CTestTestfile.cmake
Testing/
compile_commands.json
_deps/
install_manifest.txt
CPackConfig.cmake
CPackSourceConfig.cmake

# ---------------------------------------------------------------------
# vcpkg local installs (kept out; vcpkg.json describes what's needed)
# ---------------------------------------------------------------------
vcpkg_installed/
vcpkg/downloads/
vcpkg/buildtrees/
vcpkg/packages/

# ---------------------------------------------------------------------
# Downloaded third-party binaries (yt-dlp, ffmpeg, ffprobe, archives)
# setup.bat repopulates these.  Never commit them.
# ---------------------------------------------------------------------
third_party/
!third_party/.

# Generated clips + run artifacts. The README documenting the layout ships.
out/*
!out/README.md

# ---------------------------------------------------------------------
# Test debris — doctest write_clip_ass tests emit these into whatever
# CWD the test runner is invoked from. Regenerated every test run;
# never committed.
# ---------------------------------------------------------------------
english_untouched.ass
hindi_roman.ass
hindi_user_example.ass
/*.ass

# ---------------------------------------------------------------------
# Local Claude Code / editor state — skills, launch.json, agent chat,
# per-user config. Machine-local, never pushed.
# ---------------------------------------------------------------------
.claude/